# Secrets
# .env holds the PostgreSQL password. Never commit it.
backend/.env
.env
*.env
!.env.example

# Model weights
# Shipped via a GitHub Release instead. best_cnn.pt (90MB) and best_hybrid.pt
# (96MB) are past GitHub's 50MB warning and close to its 100MB hard limit.
backend/models/weights/*.pt
backend/models/weights/*.pth
backend/models/weights/*.joblib
backend/models/weights/*.pkl

