# Datasets
# Named individually so data/metadata stays trackable, since git cannot
# re-include a file whose parent directory is excluded.
**/data/raw/**
!**/data/raw/**/
!**/data/raw/**/.gitkeep
**/data/unseen/**
!**/data/unseen/**/
!**/data/unseen/**/.gitkeep
# MNW is a git clone. Listed after the negations, since the last match wins.
**/data/unseen/MNW
**/data/processed/
**/data/frequency_domain/
datasets/

# Training artefacts. results/ is deliberately absent and is tracked.
checkpoints/
logs/
runs/
outputs/
*.log

# Working notes
testLog.md
completion_checklist.md
structure.md

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
