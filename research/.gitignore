# Only the rules the root .gitignore does not already cover.
# Everything else, Python caches, virtualenvs, checkpoints, the dataset tree and
# the MNW gitlink guard, is handled once at the root.

# Generated metadata logs, written by the download and split scripts
data/metadata/download_manifest.json
data/metadata/sources.json

# Keep the core metadata trackable
!data/metadata/
!data/metadata/dataset_info.csv
!data/metadata/splits.json
