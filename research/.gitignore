# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Build / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dataset files (large, source-managed outside git)
# raw and unseen keep their directory skeleton and .gitkeep markers, so a clone
# shows where the downloads belong. Excluding the directory outright would stop
# git descending into it and no negation below could reach the marker.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/unseen/**
!data/unseen/**/
!data/unseen/**/.gitkeep
# MNW is a git clone, so the directory negation above would otherwise stage it
# as a gitlink pointing at a commit nothing in this repository can resolve.
# Listed after the negations because the last matching pattern wins.
data/unseen/MNW
# generated by split_dataset.py, so a clone does not need the skeleton
data/processed/
data/frequency_domain/

# Generated metadata logs
data/metadata/download_manifest.json
data/metadata/sources.json

# Training artifacts
# results/ is tracked: it holds the metrics and figures behind the
# dissertation tables.
checkpoints/
logs/

# Keep core metadata trackable
!data/metadata/
!data/metadata/dataset_info.csv
!data/metadata/splits.json
