* text=auto eol=lf

# Marked explicitly rather than left to content detection, since a file wrongly
# treated as text would be corrupted by normalisation.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pt binary
*.pth binary
*.ckpt binary
*.joblib binary
*.pkl binary
*.npy binary

# SVG is XML, so normalisation cannot corrupt it and a diff is worth having
*.svg text eol=lf
